# ============================================================
#  AI Stockbroker - local configuration
#  Copy this file to `.env` and fill in your keys to run locally.
#  In GitHub Actions these come from repo Secrets/Variables instead.
#  `.env` is git-ignored - your keys never get committed.
# ============================================================

# --- Required keys ---
ANTHROPIC_API_KEY=sk-ant-...
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Trading mode ---
# paper = fake money, real live market data (the sandbox). Always start here.
# live  = REAL money. Only switch when you fully trust the bot.
TRADING_MODE=paper

# In live mode, orders are written as PROPOSED and NOT sent automatically.
# You approve them from the dashboard. Set to false to let live auto-execute
# (do this only once you trust it - it trades real money with no human check).
LIVE_REQUIRE_APPROVAL=true

# dry_run = do all the research + build a trade plan, but place NO orders at all.
# Great for your very first test run. true/false.
DRY_RUN=false

# --- The AI ---
# Sonnet 5 is the cost/quality sweet spot (~60% cheaper than Opus, keeps web
# search). Use claude-opus-5 for max quality, or claude-haiku-4-5 for cheapest.
CLAUDE_MODEL=claude-sonnet-5
# Let the AI search the web for live news/sentiment during research (true/false).
# Requires an Opus/Sonnet model (not Haiku).
ENABLE_WEB_SEARCH=true
# A second, independent AI audits every trade before it executes and can veto
# ones that aren't clearly justified (the anti-"black box" check). true/false.
ENABLE_AUDITOR=true

# --- Capital cap ---
# Make the bot behave as if it only has this much money, regardless of the real
# (much larger) paper balance. All sizing/risk is computed against it. The
# currency is a label only - the Alpaca account is USD-denominated. Set
# CAPITAL_CAP=0 to disable and trade the full account.
CAPITAL_CAP=1000
CAPITAL_CURRENCY=CHF

# --- What to trade ---
# Comma-separated tickers the AI is allowed to consider.
WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,AMD,SPY,QQQ

# --- Risk limits (the guardrails the AI cannot exceed) ---
# RISK_LEVEL picks a preset; the specific vars below override it if set.
#   low       = alloc 15% / cash reserve 15% / 3 orders   (cautious)
#   medium    = alloc 25% / cash reserve 5%  / 4 orders   (balanced)
#   semi-high = alloc 40% / cash reserve 2%  / 5 orders   (aggressive)
#   high      = alloc 60% / cash reserve 0%  / 6 orders   (very aggressive)
RISK_LEVEL=semi-high
# Optional explicit overrides (leave unset to use the preset above):
# MAX_ORDERS_PER_RUN=5
MAX_NOTIONAL_PER_ORDER=1000
# MAX_ALLOCATION_PCT_PER_SYMBOL=40
# MIN_CASH_RESERVE_PCT=2
ALLOW_SHORT=false
